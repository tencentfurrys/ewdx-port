				me_tub(4) = 3
				me_tub(5) = 0
				pausedark = 0
				pause_menu = 1
			}
		}
		if ( pause_menu == 1 ) {
			me_tub_s = 0
			me_tub_y = 26
			alldark += 20
			if ( alldark > 200 ) {
				alldark = 200
				pause_menu = 2
			}
		}
