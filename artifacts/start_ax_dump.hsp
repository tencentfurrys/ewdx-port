		}
		if ( tex_t == 47 ) {
			DGRECT 344, 0, 8, 8
		}
		if ( tex_t == 40 ) {
			DGRECT 396, 0, 8, 8
		}
		if ( tex_t == 41 ) {
			DGRECT 404, 0, 8, 8
		}
		if ( tex_t == 32 ) {
			continue
		}
		if ( prm_355 == 0 ) {
			if ( prm_354 == 0 ) {
				DGPOS prm_351 + 8 * cnt, prm_352
			}
			else {
				if ( prm_354 == 1 ) {
					DGPOS prm_351 - 8 * strlen(tex_w) + 8 * cnt, prm_352
				}
				else {
					if ( prm_354 == 2 ) {
						DGPOS (-1.0) * (strlen(tex_w) * 8) / 2 + prm_351 + 8 * cnt, prm_352
					}
				}
			}
		}
		else {
			if ( prm_354 == 0 ) {
				DGPOS prm_351 + 16 * cnt, prm_352
			}
			else {
				if ( prm_354 == 1 ) {
					DGPOS prm_351 - 16 * strlen(tex_w) + 16 * cnt, prm_352
				}
				else {
					if ( prm_354 == 2 ) {
						DGPOS (-1.0) * (strlen(tex_w) * 16) / 2 + prm_351 + 16 * cnt, prm_352
					}
				}
			}
		}
		DGGCOPY 3
	loop
	return
#deffunc tex_s int prm_356, int prm_357, int prm_358, int prm_359
	DGSCALEANDANGLE 256, 256, 0
	DGBLENDMODE 1
	repeat keta(prm_358)
		DGRECT 352 + 4 * (prm_358 \ pow10(cnt + 1) / pow10(cnt)), 0, 4, 8
		if ( prm_359 == 0 ) {
			DGPOS prm_356 + 4 * keta(prm_358) - 4 * cnt, prm_357
		}
		else {
			DGPOS prm_356 - 4 * cnt, prm_357
		}
		DGGCOPY 3
	loop
