#deffunc subp_stat int prm_408, int prm_409, int prm_410, int prm_411, int prm_412
	sbpturn2 = 0
	sbpturn3 = 0
	subpturnp = prm_412
	subpturnv = 0
	if ( part(16, prm_410, fr, mo) == 0 ) {
		if ( p_spin ) {
			roll2 = part(8, prm_410, fr, mo) + p_spin
			s_a = double_angle(roll2)
			x1 = part(0, prm_410, fr, mo)
			y1 = part(1, prm_410, fr, mo)
			s_b = atan(y1, x1)
			x2 = sqrt(x1 * x1 + y1 * y1) * cos(s_b + s_a)
			y2 = sqrt(x1 * x1 + y1 * y1) * sin(s_b + s_a)
			roll2 = roll2 \ 256
			if ( roll2 < 0 ) {
				roll2 = 256 + roll2
			}
			x1 = double(strf("%0.0f", x2))
			y1 = double(strf("%0.0f", y2))
		}
		else {
			roll2 = part(8, prm_410, fr, mo)
			x1 = part(0, prm_410, fr, mo)
			y1 = part(1, prm_410, fr, mo)
		}
		if ( p_turn ) {
			if ( p_spin ) {
				s_a = double_angle(p_spin)
				s_b = atan(y2, x2)
				x1 = double(strf("%0.0f", sqrt(x2 * x2 + y2 * y2) * cos(3.1416 - s_b + 2.0 * s_a)))
				y1 = double(strf("%0.0f", sqrt(x2 * x2 + y2 * y2) * sin(3.1416 - s_b + 2.0 * s_a)))
				roll2 = int_angle(2.0 * s_a - double_angle(roll2))
			}
			else {
				x1 = -x1
				roll2 = int_angle(2.0 * 3.14159265358979 - double_angle(roll2))
			}
			roll2 = roll2 \ 256
			if ( roll2 < 0 ) {
				roll2 = 256 + roll2
			}
		}
		smx = vmx + x1
		smy = vmy + y1
	}
	else {
		x1 = part(0, prm_410, fr, mo)
		y1 = part(1, prm_410, fr, mo)
		roll2 = part(8, prm_410, fr, mo)
		if ( sideframe == 0 ) {
			sbpsp = sbpssp(prm_410)
			if ( p_spin ) {
				roll3 = part(8, sbpsp, fr, mo) + p_spin
				s_a = double_angle(p_spin)
				x3 = part(0, sbpsp, fr, mo)
				y3 = part(1, sbpsp, fr, mo)
				s_b = atan(y4, x4)
				x4 = sqrt(x3 * x3 + y3 * y3) * cos(s_b + s_a)
				y4 = sqrt(x3 * x3 + y3 * y3) * sin(s_b + s_a)
				x3 = double(strf("%0.0f", x4))
				y3 = double(strf("%0.0f", y4))
			}
			else {
				roll3 = part(8, sbpsp, fr, mo)
				x3 = part(0, sbpsp, fr, mo)
				y3 = part(1, sbpsp, fr, mo)
			}
			if ( p_turn ) {
				if ( p_spin ) {
					s_a = double_angle(p_spin)
					s_b = atan(y4, x4)
					x3 = double(strf("%0.0f", sqrt(x4 * x4 + y4 * y4) * cos(3.1416 - s_b + 2.0 * s_a)))
					y3 = double(strf("%0.0f", sqrt(x4 * x4 + y4 * y4) * sin(3.1416 - s_b + 2.0 * s_a)))
					roll3 = int_angle(2.0 * s_a - double_angle(roll3))
				}
				else {
					x3 = -x3
					roll3 = int_angle(2.0 * 3.14159265358979 - double_angle(roll3))
				}
			}
			roll3 = roll3 \ 256
			if ( roll3 < 0 ) {
				roll3 = 256 + roll3
			}
			x2 = part(0, prm_410, fr, mo) - (part(2, sbpsp, fr, mo) - 128 + part(4, sbpsp, fr, mo) / 2)
			y2 = part(1, prm_410, fr, mo) - (part(3, sbpsp, fr, mo) - 128 + part(5, sbpsp, fr, mo) / 2)
			roll2 = roll3 + part(8, prm_410, fr, mo)
			s_b = atan(y2, x2)
			s_c = sqrt(x2 * x2 + y2 * y2)
			s_d = 1.0 * double_angle(roll3)
			x2 = double(strf("%0.0f", s_c * cos(s_b + s_d)))
			y2 = double(strf("%0.0f", s_c * sin(s_b + s_d)))
			if ( part(14, sbpsp, fr, mo) == 1 ) {
				sbpturn3 = 1
				s_b = atan(y2, x2)
				spx = x2
				spy = y2
				x2 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(-s_b + 2.0 * s_d)))
				y2 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(-s_b + 2.0 * s_d)))
				roll2 = int_angle(2.0 * s_d - double_angle(roll2))
				roll2 = roll2 \ 256
				if ( roll2 < 0 ) {
					roll2 = 256 + roll2
				}
			}
			if ( part(15, sbpsp, fr, mo) == 1 ) {
				sbpturn2 = 1
			}
			if ( part(15, sbpsp, fr, mo) == 1 & p_turn == 0 | (part(15, sbpsp, fr, mo) == 0 & p_turn == 1) ) {
				s_b = atan(y2, x2)
				spx = x2
				spy = y2
				x2 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(3.1416 - s_b + 2.0 * s_d)))
				y2 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(3.1416 - s_b + 2.0 * s_d)))
				roll2 = int_angle(2.0 * s_d - double_angle(roll2))
				roll2 = roll2 \ 256
				if ( roll2 < 0 ) {
					roll2 = 256 + roll2
				}
			}
			smx = vmx + x2 + x3
			smy = vmy + y2 + y3
		}
		else {
			smx = 128.0 + x1
			smy = 128.0 + y1
		}
	}
	s_b = atan(prm_409, prm_408)
	s_c = sqrt(prm_408 * prm_408 + prm_409 * prm_409)
	s_d = 1.0 * double_angle(roll2)
	x1 = double(strf("%0.0f", s_c * cos(s_b + s_d)))
	y1 = double(strf("%0.0f", s_c * sin(s_b + s_d)))
	roll1 = prm_411 + roll2
	if ( sideframe == 0 ) {
		if ( part(14, prm_410, fr, mo) == 1 & sbpturn3 == 0 | (part(14, prm_410, fr, mo) == 0 & sbpturn3 == 1) ) {
			s_b = atan(y1, x1)
			spx = x1
			spy = y1
			x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(-s_b + 2.0 * s_d)))
			y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(-s_b + 2.0 * s_d)))
		}
	}
	else {
		if ( part(16, prm_410, fr, mo) == 0 ) {
			if ( part(14, prm_410, fr, mo) == 1 ) {
				s_b = atan(y1, x1)
				spx = x1
				spy = y1
				x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(-s_b + 2.0 * s_d)))
				y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(-s_b + 2.0 * s_d)))
			}
		}
		else {
			if ( part(14, prm_410, fr, mo) == 1 ) {
				s_b = atan(y1, x1)
				spx = x1
				spy = y1
				x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(-s_b + 2.0 * s_d)))
				y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(-s_b + 2.0 * s_d)))
			}
		}
	}
	if ( sideframe == 0 ) {
		if ( part(15, prm_410, fr, mo) == 1 & sbpturn2 == 0 & p_turn == 0 | (part(15, prm_410, fr, mo) == 0 & sbpturn2 == 1 & p_turn == 0) | (part(15, prm_410, fr, mo) == 0 & sbpturn2 == 0 & p_turn == 1) | (part(15, prm_410, fr, mo) == 1 & sbpturn2 == 1 & p_turn == 1) ) {
			s_b = atan(y1, x1)
			spx = x1
			spy = y1
			x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(3.1416 - s_b + 2.0 * s_d)))
			y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(3.1416 - s_b + 2.0 * s_d)))
		}
	}
	else {
		if ( part(16, prm_410, fr, mo) == 0 ) {
			if ( part(15, prm_410, fr, mo) == 1 & p_turn == 0 | (part(15, prm_410, fr, mo) == 0 & p_turn == 1) ) {
				s_b = atan(y1, x1)
				spx = x1
				spy = y1
				x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(3.1416 - s_b + 2.0 * s_d)))
				y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(3.1416 - s_b + 2.0 * s_d)))
			}
		}
		else {
			if ( part(15, prm_410, fr, mo) == 1 ) {
				s_b = atan(y1, x1)
				spx = x1
				spy = y1
				x1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * cos(3.1416 - s_b + 2.0 * s_d)))
				y1 = double(strf("%0.0f", sqrt(spx * spx + spy * spy) * sin(3.1416 - s_b + 2.0 * s_d)))
			}
		}
	}
	if ( part(16, prm_410, fr, mo) == 0 ) {
		if ( p_turn == 1 ) {
			subpturnp = subpturnp == 0
		}
	}
	if ( part(16, prm_410, fr, mo) == 1 & sideframe == 0 ) {
		if ( part(15, sbpsp, fr, mo) == 1 ) {
			subpturnp = subpturnp == 0
		}
	}
	if ( part(15, prm_410, fr, mo) == 1 ) {
		subpturnp = subpturnp == 0
	}
	if ( part(16, prm_410, fr, mo) == 1 & sideframe == 0 ) {
		if ( part(14, sbpsp, fr, mo) == 1 ) {
			subpturnv = subpturnv == 0
		}
	}
	if ( part(14, prm_410, fr, mo) == 1 ) {
		subpturnv = subpturnv == 0
	}
	DGPOS smx + x1, smy + y1
	DGSCALEANDANGLE 256, 256, roll1
	DGCOLOR part(9, prm_410, fr, mo), part(10, prm_410, fr, mo), part(11, prm_410, fr, mo), part(12, prm_410, fr, mo)
	DGBLENDMODE part(13, prm_410, fr, mo)
	if ( sideframe == 1 & part(16, prm_410, fr, mo) == 0 ) {
		DGGSEL dtw_n
	}
	DGGCOPY unit(6 + part(18, prm_410, fr, mo), pn), 5 + subpturnv * 16 + subpturnp * 8
	if ( sideframe == 1 & part(16, prm_410, fr, mo) == 0 ) {
		DGGSEL 2
	}
	return
#defcfunc subp_get int prm_413
	subpn2 = -1
	repeat
		if ( part(13, cnt, fr, mo) == 0 ) {
			break
		}
		if ( part(17, cnt, fr, mo) == 1 ) {
			continue
		}
		if ( part(23, cnt, fr, mo) == prm_413 ) {
			subpn2 = cnt
			break
		}
	loop
	return subpn2
#defcfunc sbpssp int prm_414
	repeat
		if ( prm_414 - cnt <= 0 ) {
			subpn2 = 0
			break
		}
		if ( part(16, prm_414 - cnt, fr, mo) == 0 ) {
			subpn2 = prm_414 - cnt + 1
			break
		}
	loop
	return subpn2
#deffunc draw_usa
	fr2 = unit(12, usako2)
	mo2 = unit(21, usako2)
	p_turn = unit(3, pn)
	usa_x = part(0, subp_get(4), fr, mo) - part(0, subp_get2(4), fr2, mo2)
	usa_y = part(1, subp_get(4), fr, mo) - part(1, subp_get2(4), fr2, mo2)
	repeat 100
		if ( part(13, cnt, fr2, mo2) == 0 ) {
			break
		}
		if ( part(17, cnt, fr2, mo2) == 1 ) {
			continue
		}
		if ( part(23, cnt, fr2, mo2) == 4 | (part(23, cnt, fr2, mo2) >= 9 & part(23, cnt, fr2, mo2) <= 14) ) {
			continue
		}
		if ( part(19, cnt, fr2, mo2) == 1 ) {
			DGGSEL 6
			ctl = cnt
			DGCOLOR 0, 0, 0, 256
			DGCLEAR
			DGTEXTURE unit(6 + part(18, cnt, fr2, mo2), pn)
			l_amp = 1.0 * part(20, ctl, fr2, mo2)
			l_freq = 0.001 * part(21, ctl, fr2, mo2)
			l_phase = 0.01 * part(22, ctl, fr2, mo2)
			DGBLENDMODE 1
			repeat part(5, ctl, fr2, mo2)
				l_size_x = l_amp * sin(l_freq * cnt + l_phase)
				DGRECT part(2, ctl, fr2, mo2), part(3, ctl, fr2, mo2) + cnt, part(4, ctl, fr2, mo2), 1 + (cnt == 0)
				DGCOLOR 255, 255, 255, 255
				DGSCALEANDANGLE part(4, ctl, fr2, mo2) + l_size_x, 1 + (cnt == 0), 0
				DGPOS (part(4, ctl, fr2, mo2) + l_amp) / 2 + l_size_x / 2, cnt + 1
				DGADDPRIMITIVE 7
			loop
			DGDRAWPRIMITIVE
			DGGSEL dtw_n
			DGRECT 0, 0, part(4, ctl, fr2, mo2) + l_amp, part(5, cnt, fr2, mo2)
		}
		else {
			DGRECT part(2, cnt, fr2, mo2), part(3, cnt, fr2, mo2), part(4, cnt, fr2, mo2), part(5, cnt, fr2, mo2)
		}
		roll1 = part(8, cnt, fr2, mo2)
		x1 = part(0, cnt, fr2, mo2)
		y1 = part(1, cnt, fr2, mo2)
		if ( p_turn ) {
			x1 = -x1
			roll1 = int_angle(2.0 * 3.14159265358979 - double_angle(roll1))
			roll1 = roll1 \ 256
			if ( roll1 < 0 ) {
				roll1 = 256 + roll1
			}
		}
		DGPOS vmx + x1 + usa_x - 2 * usa_x * p_turn, vmy + y1 + usa_y
		DGSCALEANDANGLE part(6, cnt, fr2, mo2), part(7, cnt, fr2, mo2), roll1
		DGCOLOR part(9, cnt, fr2, mo2), part(10, cnt, fr2, mo2), part(11, cnt, fr2, mo2), part(12, cnt, fr2, mo2)
		if ( unit(26, pn) < (-4) ) {
			if ( unit(26, pn) \ 2 == 0 ) {
				DGCOLOR 80, 10, 10, part(12, cnt, fr2, mo2)
			}
		}
		DGBLENDMODE part(13, cnt, fr2, mo2)
		if ( p_spd == 1 ) {
			if ( pn == 0 ) {
				if ( p_light ) {
					DGCOLOR part(9, cnt, fr2, mo2), part(10, cnt, fr2, mo2), part(11, cnt, fr2, mo2), p_light
					DGBLENDMODE 2
				}
			}
		}
		if ( part(19, cnt, fr2, mo2) == 0 ) {
			DGGCOPY unit(6 + part(18, cnt, fr2, mo2), usako2), 7 + part(14, cnt, fr2, mo2) * 16 + (part(15, cnt, fr2, mo2) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr2, mo2) == 1 & p_turn == 1) * 8
		}
		else {
			DGGCOPY 6, 7 + part(14, cnt, fr2, mo2) * 16 + (part(15, cnt, fr2, mo2) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr2, mo2) == 1 & p_turn == 1) * 8
		}
		if ( slimy | poison ) {
			if ( part(18, cnt, fr2, mo2) == 1 ) {
				draw_slimy2
			}
		}
	loop
	return
#defcfunc subp_get2 int prm_415
	subpn2 = -1
	repeat
		if ( part(13, cnt, fr2, mo2) == 0 ) {
			break
		}
		if ( part(17, cnt, fr2, mo2) == 1 ) {
			continue
		}
		if ( part(23, cnt, fr2, mo2) == prm_415 ) {
			subpn2 = cnt
			break
		}
	loop
	return subpn2
#deffunc draw_slimy
	if ( part(19, cnt, fr, mo) == 1 | part(18, cnt, fr, mo) != 1 ) {
		return
	}
	if ( slimy ) {
		DGCOLOR 255, 255, 255, 190
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + count / 8 \ 3) + ""), 7 + part(14, cnt, fr, mo) * 16 + (part(15, cnt, fr, mo) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr, mo) == 1 & p_turn == 1) * 8
	}
	if ( poison ) {
		DGCOLOR 191, 64, 223, 96
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + (count + 16) / 8 \ 3) + ""), 7 + part(14, cnt, fr, mo) * 16 + (part(15, cnt, fr, mo) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr, mo) == 1 & p_turn == 1) * 8
	}
	return
#deffunc draw_slimy2
	if ( part(19, cnt, fr2, mo2) == 1 | part(18, cnt, fr2, mo2) != 1 ) {
		return
	}
	if ( slimy ) {
		DGCOLOR 255, 255, 255, 190
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + count / 8 \ 3) + ""), 7 + part(14, cnt, fr2, mo2) * 16 + (part(15, cnt, fr2, mo2) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr2, mo2) == 1 & p_turn == 1) * 8
	}
	if ( poison ) {
		DGCOLOR 191, 64, 223, 96
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + (count + 16) / 8 \ 3) + ""), 7 + part(14, cnt, fr2, mo2) * 16 + (part(15, cnt, fr2, mo2) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr2, mo2) == 1 & p_turn == 1) * 8
	}
	return
#deffunc draw_slimy3
	if ( part(19, cnt, fr, mo) == 1 | part(18, cnt, fr, mo) != 2 ) {
		return
	}
	if ( slimy ) {
		DGCOLOR 255, 255, 255, 190
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + count / 8 \ 3) + ""), 7 + part(14, cnt, fr, mo) * 16 + (part(15, cnt, fr, mo) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr, mo) == 1 & p_turn == 1) * 8
	}
	if ( poison ) {
		DGCOLOR 191, 64, 223, 96
		DGBLENDMODE 1
		DGGCOPY npic("slimy" + (1 + (count + 16) / 8 \ 3) + ""), 7 + part(14, cnt, fr, mo) * 16 + (part(15, cnt, fr, mo) == 1 | p_turn == 1) * 8 - (part(15, cnt, fr, mo) == 1 & p_turn == 1) * 8
	}
	return
#deffunc seplay str prm_416, int prm_417, int prm_418
	if ( prm_416 == "" ) {
		return
	}
	if ( prm_417 > 0 & se > 0 ) {
		sevol = 20.0 * 100 * (logf(0.01 * se * prm_417 / 100.0) / logf(10))
	}
	else {
		sevol = -10000.0
	}
	repeat length(sound)
		if ( sound(cnt) == prm_416 ) {
			dmmvol cnt, sevol
			dmmpan cnt, prm_418
			dmmplay cnt
			break
		}
		if ( cnt == length(sound) - 1 ) {
			if ( dir_c == 0 ) {
				w_w = "data\\se\\" + prm_416 + ".wav"
			}
			else {
				w_w = "" + prm_416 + ".wav"
			}
			exist w_w
			if ( strsize == (-1) ) {
				dialog "効果音「" + prm_416 + "」がないんだぜ", 1, "ERROR!"
				break
			}
			else {
				if ( sound(cnt) == "" ) {
					sound(cnt) = prm_416
					dmmload w_w, cnt
					dmmvol cnt, sevol
					dmmpan cnt, prm_418
					dmmplay cnt
					break
				}
				else {
					sound(cnt + 1) = prm_416
					dmmload w_w, cnt + 1
					dmmvol cnt + 1, sevol
					dmmpan cnt + 1, prm_418
					dmmplay cnt + 1
					break
				}
			}
		}
	loop
	return
#deffunc seplay_o str prm_419, int prm_420, int prm_421
	span = (unit_d(0, prm_420) - fx - 160.0 * c_size) * 6
	volume_mi = 0
	if ( abs(unit_d(0, prm_420) - fx - 160.0 * c_size) > 160.0 * c_size ) {
		volume_mi = (abs(unit_d(0, prm_420) - fx - 160.0 * c_size) - 160.0 * c_size) / 2
	}
	if ( abs(span) > 10000 ) {
		if ( span > 0 ) {
			span = 10000
		}
		else {
			span = -10000
		}
	}
	seplay prm_419, prm_421 - volume_mi, span
	return
#deffunc sestop str prm_422
	repeat length(sound)
		if ( sound(cnt) == prm_422 ) {
			dmmstop cnt
			break
		}
	loop
	return
#deffunc set_volume
	if ( bgmfeed > 0.0 & bgm > 0 ) {
		cmd_0_7 0, 20.0 * 100 * (logf(1.0 * (bgmfeed * bgm) / 100.0) / logf(10))
	}
	else {
		cmd_0_7 0, -10000
	}
	return
#deffunc bgmload str prm_423, int prm_424
	if ( music == prm_423 ) {
		bgm_feed_out = 0
		bgmfeed = 1.0
		set_volume
		m_volume = 0
		m_stop = 0
		return
	}
	cmd_0_6 0
	m_stop = 1
	if ( prm_423 != "" ) {
		if ( dir_c == 0 ) {
			m_name = "data\\music\\" + prm_423 + ""
		}
		else {
			m_name = prm_423
		}
		exist m_name
		if ( strsize == (-1) ) {
			return
		}
		ov_load m_name, 0, 98304
		looptime = 0.0
		if ( prm_423 == "0.ogg" ) {
			looptime = 0.0
			loopstart = -1.0
		}
		if ( prm_423 == "1.ogg" ) {
			bgm_name = "journey into the night"
			looptime = 14.21 * 44100
			loopstart = (3.0 * 60.0 + 4.61) * 44100
		}
		if ( prm_423 == "2.ogg" ) {
			bgm_name = "yggdrasil -root of the world-"
			looptime = 28.19 * 44100
			loopstart = -1.0
		}
		if ( prm_423 == "3.ogg" ) {
			bgm_name = "sacred to the darkness"
			looptime = 54.8 * 44100
			loopstart = -1.0
		}
		if ( prm_423 == "5.ogg" ) {
			looptime = 0.0
			loopstart = -1.0
		}
		if ( prm_423 == "6.ogg" ) {
			looptime = 0.0
			loopstart = -1.0
		}
		if ( prm_423 == "7.ogg" ) {
			looptime = (1.0 * 60.0 + 24.245) * 44100
			loopstart = (2.0 * 60.0 + 29.77) * 44100
		}
		if ( prm_423 == "8.ogg" ) {
			looptime = 0.0
			loopstart = -1.0
		}
		if ( prm_423 == "9.ogg" ) {
			looptime = 0.0
			loopstart = -1.0
		}
		bgm_feed_out = 0
		bgmfeed = 1.0
		if ( prm_424 == 0 ) {
			cmd_0_5 0, 0, looptime, loopstart, -1
		}
		else {
			cmd_0_3 0, 0
		}
		set_volume
		m_volume = 0
		m_stop = 0
	}
	music = prm_423
	return
#deffunc bgmfeedout double prm_425
	m_stop = 0
	bgmfeed -= prm_425
	set_volume
	if ( bgmfeed <= 0.0 ) {
		m_stop = 1
		bgmfeed = 0.0
		bgmload ""
		return
