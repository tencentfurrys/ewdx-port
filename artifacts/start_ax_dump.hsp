		bmpload pic(cnt), 7 + cnt
	loop
	bmpload "p" + chara + "" + cloth_tp + "" + cloth_lv + "", npic("player")
	return
*label_244
	gosub *label_035
	dmmbye
	DIEND
	DGEND
	end
