					ending_t++
					if ( ending_t >= 40 ) {
						backtotitle = 1
						ending_t = 0
					}
				}
			}
			if ( dark <= 0 ) {
				dark = 0
			}
		}
		DGBLENDMODE 1
		repeat 12
			DGCOLOR 0, 0, 0, 48
			dgboxf 340 - 5 * cnt, 0, 640, 480
		loop
		endingfx = 340
		DGCOLOR 255, 255, 255, ending_msl
		if ( ending_ms == 1 ) {
			tex 320, 230, ending_m(0), 2, 1
		}
		if ( ending_ms == 2 ) {
			tex 320, 220, ending_m(1), 2, 1
			tex 320, 250, ending_m(2), 2, 1
		}
		if ( ending_ms == 3 ) {
			tex endingfx, 200, ending_m(3), 0, 1
			tex endingfx + 60, 250, ending_m(4), 0, 1
		}
		if ( ending_ms == 4 ) {
			tex endingfx, 200, ending_m(5), 0, 1
			tex endingfx + 60, 250, ending_m(6), 0, 1
		}
		if ( ending_ms == 5 ) {
			tex endingfx, 150, ending_m(7), 0, 1
			repeat 5
				tex endingfx + 60, 200 + 35 * cnt, ending_m(8 + cnt), 0, 1
			loop
		}
		if ( ending_ms >= 10 ) {
			DGCOLOR 0, 128, 255, ending_msl
			tex endingfx, 160, "result", 0, 1
			DGCOLOR 255, 255, 255, ending_msl
			tex endingfx - 32, 200, "difficulty - ", 0, 1
			if ( dif == 0 ) {
				DGCOLOR 255, 200, 64, ending_msl
				tex endingfx - 32 + 13 * 16, 200, "puki", 0, 1
			}
			if ( dif == 1 ) {
				DGCOLOR 100, 255, 0, ending_msl
				tex endingfx - 32 + 13 * 16, 200, "easy", 0, 1
			}
			if ( dif == 2 ) {
				DGCOLOR 0, 128, 255, ending_msl
				tex endingfx - 32 + 13 * 16, 200, "normal", 0, 1
			}
			if ( dif == 3 ) {
				DGCOLOR 180, 100, 255, ending_msl
				tex endingfx - 32 + 13 * 16, 200, "hard", 0, 1
			}
			if ( dif >= 4 ) {
				DGCOLOR 255, 64, 32, ending_msl
				tex endingfx - 32 + 13 * 16, 200, "chaos", 0, 1
			}
			DGCOLOR 255, 255, 255, ending_msl
			tex endingfx - 32, 220, "     score - " + score + "", 0, 1
			if ( newreco ) {
				DGCOLOR 255, 128, 0, ending_msl
				tex endingfx + 40, 238, "(new record!)", 0, 1
			}
			DGCOLOR 255, 255, 255, ending_msl
			tex endingfx - 32, 270, "  continue - " + continue_n + "", 0, 1
		}
		if ( ending_ms == 11 ) {
			DGCOLOR 255, 255, 255, ending_msl
			tex endingfx + 60, 360, "press(z)key", 0, 1
		}
	}
	return
*label_227
	DGGSEL 5
