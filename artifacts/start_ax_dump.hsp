#deffunc draw_grav
	DGTEXTURE 3
	DGCOLOR 255, 255, 255, 255
	DGRECT 0, 64, 32, 8
	repeat length2(unit)
		if ( unit(2, cnt) <= 1 | unit(2, cnt) == 4 ) {
			continue
		}
		fr = unit(12, cnt)
		pn2 = unit(21, cnt)
		if ( scope(35, fr, pn2) == 0 ) {
			continue
		}
		if ( unit(1, cnt) & 64 ) {
			continue
		}
		x = unit_d(0, cnt)
		sdf = 0
		sdy = 0
		sdn = 0
		pn = cnt
		repeat length2(cort)
			if ( cort(6, cnt) == 1 ) {
				continue
			}
			if ( cort(4, cnt) != 1 & (cort(4, cnt) != 16 | unit(17, pn) >= 1) ) {
				continue
			}
			if ( cort(0, cnt) < cort(2, cnt) & (x < cort(0, cnt) | x > cort(2, cnt)) | cort(0, cnt) > cort(2, cnt) & (x > cort(0, cnt) | x < cort(2, cnt)) ) {
				continue
			}
			cy = 1.0 * (cort(3, cnt) - cort(1, cnt)) / (cort(2, cnt) - cort(0, cnt)) * (x - cort(0, cnt)) + cort(1, cnt)
			if ( sdf == 0 | sdy > cy & unit_d(1, pn) + scope(33, fr, pn2) <= cy ) {
				sdf = 1
				sdn = cnt
				sdy = cy
			}
		loop
		if ( sdf == 0 ) {
			continue
		}
		sdratio = (180.0 - (sdy - (unit_d(1, pn) + scope(33, fr, pn2)))) / 180
		sdsize = sdratio * scope(35, fr, pn2)
		if ( sdsize <= 6 ) {
			sdsize = 6
		}
		DGSCALEANDANGLE sdsize, 8, int_angle(atan(cort(3, sdn) - cort(1, sdn), cort(2, sdn) - cort(0, sdn)))
		DGPOS (-0.01) * unit(19, pn) * fcx - fx + fcx + unit_d(0, pn) + (sdsize - 32) / 2 + scope(34, fr, pn2) * dire(pn), (-0.01) * unit(19, pn) * fcy - fy + fcy + sdy
		DGADDPRIMITIVE 7
	loop
	DGBLENDMODE 4
	DGDRAWPRIMITIVE
	return
#deffunc drawline
