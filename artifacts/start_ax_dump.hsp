#deffunc put_frame int prm_380, int prm_381, int prm_382, int prm_383, int prm_384, int prm_385, int prm_386, int prm_387
	DGSCALEANDANGLE 256, 256, 0
	DGCOLOR 255, 255, 255, 255
	DGTEXTURE 3
	DGPOS prm_380 - prm_384 / 2 - prm_386, prm_381 - prm_385 / 2 - prm_386
	DGRECT prm_382, prm_383, prm_386, prm_386
	DGADDPRIMITIVE
	DGPOS prm_380 + prm_384 / 2, prm_381 - prm_385 / 2 - prm_386
	DGRECT prm_382 + 2 * prm_386, prm_383, prm_386, prm_386
	DGADDPRIMITIVE
	DGPOS prm_380 - prm_384 / 2 - prm_386, prm_381 + prm_385 / 2
	DGRECT prm_382, prm_383 + 2 * prm_386, prm_386, prm_386
	DGADDPRIMITIVE
	DGPOS prm_380 + prm_384 / 2, prm_381 + prm_385 / 2
	DGRECT prm_382 + 2 * prm_386, prm_383 + 2 * prm_386, prm_386, prm_386
	DGADDPRIMITIVE
	DGPOS prm_380 - prm_384 / 2, prm_381 - prm_385 / 2 - prm_386
	DGRECT prm_382 + prm_386, prm_383, prm_386, prm_386
	DGSCALEANDANGLE prm_384, prm_386, 0
	DGADDPRIMITIVE 2
	DGSCALEANDANGLE prm_386, prm_385, 0
	DGPOS prm_380 - prm_384 / 2 - prm_386, prm_381 - prm_385 / 2
	DGRECT prm_382, prm_383 + prm_386, prm_386, prm_386
	DGADDPRIMITIVE 2
	DGPOS prm_380 + prm_384 / 2, prm_381 - prm_385 / 2
	DGRECT prm_382 + 2 * prm_386, prm_383 + prm_386, prm_386, prm_386
	DGADDPRIMITIVE 2
	DGPOS prm_380 - prm_384 / 2, prm_381 + prm_385 / 2
	DGRECT prm_382 + prm_386, prm_383 + 2 * prm_386, prm_386, prm_386
	DGSCALEANDANGLE prm_384, prm_386, 0
	DGADDPRIMITIVE 2
	DGPOS prm_380 - prm_384 / 2, prm_381 - prm_385 / 2
	DGRECT prm_382 + prm_386, prm_383 + prm_386, prm_386, prm_386
	DGSCALEANDANGLE prm_384, prm_385, 0
	DGCOLOR 255, 255, 255, prm_387
	DGADDPRIMITIVE 2
	DGSCALEANDANGLE 256, 256, 0
	DGCOLOR 255, 255, 255, 255
	DGBLENDMODE 1
	DGDRAWPRIMITIVE
	return
