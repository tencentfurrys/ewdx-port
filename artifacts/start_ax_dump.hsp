			me_tub_s += 16
			me_tub_y -= 2
			if ( me_tub_y < 0 ) {
				me_tub_y = 0
				me_tub_s = 255
				me_tub_t = 0
				pause_menu = 3
			}
		}
		if ( pause_menu == 3 ) {
		}
		if ( pause_menu == 4 ) {
			me_tub_s -= 16
			if ( me_tub_s < 0 ) {
				me_tub_s = 0
				alldark -= 20
				if ( alldark < 0 ) {
					alldark = 0
					pause_menu = 0
					me_dp1 = ""
					me_dp2 = ""
					inikey
					pause = 0
					gosub *label_035
				}
			}
		}
		if ( pause_menu == 5 ) {
			pausedark += 8
			if ( pausedark >= 255 ) {
				pausedark = 255
				pausedark_t++
				if ( pausedark_t > 10 ) {
					alldark = 0
					pause_menu = 0
					me_dp1 = ""
					me_dp2 = ""
					inikey
					pause = 0
					pausedark_t = 0
					backtotitle = 1
				}
			}
		}
		if ( pause_menu == 6 ) {
			me_tub_s -= 16
			if ( me_tub_s < 0 ) {
				me_tub_s = 0
				pause_menu = 7
				msp_slue = 0
				msp_f = 0
				msp_t = 0
			}
		}
		if ( pause_menu == 7 ) {
			gosub *label_229
			return
		}
	}
