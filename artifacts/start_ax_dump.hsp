#deffunc picture str prm_349
	repeat length(pic)
		if ( pic(cnt) == "" ) {
			bmpload prm_349, cnt + 7
			pic(cnt) = prm_349
			p_num = cnt
			break
		}
		if ( cnt == length(pic) - 1 ) {
			bmpload prm_349, cnt + 8
			pic(cnt + 1) = prm_349
			p_num = cnt + 1
			break
		}
	loop
	return
#defcfunc npic str prm_350
	repeat length(pic)
		if ( prm_350 == pic(cnt) ) {
			m_num = cnt
			break
		}
		if ( cnt == length(pic) - 1 ) {
			picture prm_350
			m_num = p_num
			break
		}
	loop
	return m_num + 7
#deffunc tex int prm_351, int prm_352, str prm_353, int prm_354, int prm_355
	if ( prm_355 == 0 ) {
		DGSCALEANDANGLE 256, 256, 0
	}
	else {
		DGSCALEANDANGLE 512, 512, 0
	}
	DGBLENDMODE 1
	tex_w = prm_353
	repeat strlen(tex_w)
		tex_t = peek(tex_w, cnt)
		if ( tex_t >= 97 & tex_t <= 122 ) {
			DGRECT 8 * (tex_t - 97), 0, 8, 8
		}
		if ( tex_t >= 48 & tex_t <= 57 ) {
			DGRECT 208 + 8 * (tex_t - 48), 0, 8, 8
		}
		if ( tex_t == 45 ) {
			DGRECT 288, 0, 8, 8
		}
		if ( tex_t == 95 ) {
			DGRECT 296, 0, 8, 8
		}
		if ( tex_t == 46 ) {
			DGRECT 304, 0, 8, 8
		}
		if ( tex_t == 33 ) {
