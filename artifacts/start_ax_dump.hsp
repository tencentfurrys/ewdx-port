		repeat part(5, ctl, fr, mo)
			l_size_x = l_amp * sin(l_freq * cnt + l_phase)
			DGRECT part(2, ctl, fr, mo), part(3, ctl, fr, mo) + cnt, part(4, ctl, fr, mo), 1 + (cnt == 0)
			DGSCALEANDANGLE part(4, ctl, fr, mo) + l_size_x, 1 + (cnt == 0), 0
