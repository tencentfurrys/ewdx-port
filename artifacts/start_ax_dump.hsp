#deffunc view_mot int prm_393, int prm_394
	pn = prm_393
	mo = unit(21, prm_393)
	fr = unit(12, prm_393)
	dtw_n = prm_394
	p_turn = unit(3, prm_393)
	p_spin = unit(4, prm_393)
	spart = -1
	vmx = (-0.01) * unit(19, pn) * fcx - fx + fcx + unit_d(0, pn)
	vmy = (-0.01) * unit(19, pn) * fcy - fy + fcy + unit_d(1, pn)
	if ( prm_394 > 1 ) {
		vmx = unit_d(0, pn)
		vmy = unit_d(1, pn)
	}
	if ( unit(2, pn) == 4 ) {
		view_blur
		return
	}
	repeat 100
		if ( part(13, cnt, fr, mo) == 0 ) {
			endpart = cnt
			break
		}
		if ( part(17, cnt, fr, mo) == 1 & (part(16, cnt, fr, mo) == 0 | sideframe == 1) ) {
			continue
		}
		if ( vore == pn | stom_n == pn & pn != 0 | (hold >= 8 & pn == 0) ) {
			if ( 31 <= part(23, cnt, fr, mo) & part(23, cnt, fr, mo) <= 44 ) {
				draw_sub 0
			}
		}
		if ( pn == 0 ) {
			if ( usa2 == 1 & chara == 2 ) {
				usa_p = part(23, cnt, fr, mo)
				if ( usa_p == 4 | (usa_p >= 9 & usa_p <= 14) ) {
				}
				else {
					continue
				}
			}
		}
		if ( part(16, cnt, fr, mo) == 0 ) {
			if ( sideframe == 1 ) {
				DGGSEL prm_394
				sideframe = 0
				if ( part(17, spart, fr, mo) == 0 ) {
					draw_spart vmx, vmy, prm_394
				}
			}
			draw_mot vmx, vmy, prm_394
		}
		else {
			if ( sideframe == 0 ) {
				sideframe = 1
				DGGSEL 2
				if ( spart == (-1) ) {
					DGCOLOR 0, 0, 0, 256
					DGCLEAR
				}
				spart = cnt
			}
			else {
				draw_side 128, 128
			}
		}
		if ( vore == pn | stom_n == pn & pn != 0 | (hold >= 8 & pn == 0) ) {
			if ( 31 <= part(23, cnt, fr, mo) & part(23, cnt, fr, mo) <= 44 ) {
				if ( slimy | poison ) {
					draw_slimy3
				}
				draw_sub 1
			}
		}
